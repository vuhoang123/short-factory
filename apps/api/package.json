    "lint": "eslint src test",
    "test": "vitest run",
    "test:integration": "vitest run test/api.integration.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.4",
    "@shorts-factory/database": "workspace:*",
    "@shorts-factory/shared": "workspace:*",
    "@shorts-factory/sources": "workspace:*",
    "express": "^5.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
