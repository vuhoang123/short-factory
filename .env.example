# Placeholders only. `pnpm local:up` generates ignored .env with random local secrets.
NODE_ENV=development
POSTGRES_USER=shorts
POSTGRES_DB=shorts_factory
POSTGRES_PASSWORD=<generate-a-local-database-password>
REDIS_PASSWORD=<generate-a-local-redis-password>
DATABASE_URL=postgresql://shorts:<database-password>@localhost:5432/shorts_factory?schema=public
TEST_DATABASE_URL=postgresql://shorts:<database-password>@localhost:5432/shorts_factory_test?schema=public
REDIS_URL=redis://:<redis-password>@localhost:6379
DISCOVERY_QUEUE_NAME=content-discovery
DISCOVERY_WORKER_CONCURRENCY=4
DISCOVERY_RATE_LIMIT_MAX=30
DISCOVERY_RATE_LIMIT_WINDOW_MS=60000
DISCOVERY_RELAY_INTERVAL_MS=3000
DISCOVERY_SCHEDULER_INTERVAL_MS=30000
DISCOVERY_BATCH_SIZE=25
DISCOVERY_PAGE_SIZE=25
DISCOVERY_MAX_PAGES=10
DISCOVERY_COMMENT_LIMIT=50
DISCOVERY_RETRY_ATTEMPTS=5
DISCOVERY_RETRY_DELAY_MS=5000
DISCOVERY_PAGE_DELAY_MS=250
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
PORT=3001
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=.data/objects
AI_PROVIDER=mock
TTS_PROVIDER=mock
PUBLISHER_PROVIDER=mock
ALLOW_REGISTRATION=true
# Official OAuth/provider integrations: BLOCKED_EXTERNAL until verified approvals and adapters exist.
# Never store OAuth tokens here or in application rows. Use encrypted secret references.
# These are inert placeholders until a reviewed adapter and provider approval exist.
# REDDIT_ACCESS_TOKEN=<managed-secret-reference>
# REDDIT_DATA_USE_APPROVED=false
# THREADS_ACCESS_TOKEN=<managed-secret-reference>
# THREADS_APP_APPROVED=false
# FACEBOOK_LICENSED_FEED_TOKEN=<managed-secret-reference>
# FACEBOOK_LICENSE_APPROVED=false
