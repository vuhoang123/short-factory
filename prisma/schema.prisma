generator client {
  provider = "prisma-client-js"
  output   = "../packages/database/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  MANUAL
  REDDIT
  THREADS
  FACEBOOK
  YOUTUBE
  TIKTOK
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  REVIEWER
  VIEWER
}

enum RightsBasis {
  OWNED
  LICENSED
  CONSENTED
  EXCEPTION_REVIEWED
  UNKNOWN
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  BLOCKED
}

enum PublicationStatus {
  DRAFT
  SCHEDULED
  QUEUED
  UPLOADING
  PROCESSING
  PUBLISHED
  FAILED_RETRYABLE
  FAILED_PERMANENT
  NEEDS_ACTION
  CANCELLED
}

enum ProductionRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED_RETRYABLE
  FAILED_PERMANENT
  CANCELLED
  BLOCKED_RIGHTS
  BLOCKED_EXTERNAL
}

enum ProductionStageStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

model User {
  id           String            @id @default(uuid())
  email        String            @unique
  name         String?
  passwordHash String
  createdAt    DateTime          @default(now())
  memberships  WorkspaceMember[]
  sessions     Session[]
}

// Users and sessions are global identity rows; tenant context is a verified membership.
model Session {
  id                String           @id @default(uuid())
  tokenHash         String           @unique
  userId            String
  activeWorkspaceId String?
  expiresAt         DateTime
  createdAt         DateTime         @default(now())
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeMembership  WorkspaceMember? @relation(fields: [activeWorkspaceId, userId], references: [workspaceId, userId], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Workspace {
  id              String               @id @default(uuid())
  slug            String               @unique
  name            String
  timezone        String               @default("Asia/Ho_Chi_Minh")
  createdAt       DateTime             @default(now())
  members         WorkspaceMember[]
  channels        ContentChannel[]
  topicRules      TopicRule[]
  sources         SourceConfig[]
  syncRuns        SourceSyncRun[]
  posts           SourcePost[]
  comments        SourceComment[]
  postMetrics     PostMetricSnapshot[]
  candidates      ContentCandidate[]
  accounts        SocialAccount[]
  stories         StoryProject[]
  storyVersions   StoryVersion[]
  videos          Video[]
  assets          MediaAsset[]
  rights          ContentRight[]
  publications    Publication[]
  publishAttempts PublicationAttempt[]
  publishMetrics  PublicationMetric[]
  workflows       WorkflowRun[]
  outbox          OutboxEvent[]
  audits          AuditLog[]
  idempotency     IdempotencyRecord[]
  productionRuns ProductionRun[]
  productionStages ProductionStage[]
  audioAssets    AudioAsset[]
  subtitleTracks SubtitleTrack[]
  renderManifests RenderManifest[]
  renderJobs     RenderJob[]
  automationRules AutomationRule[]
  automationRuleVersions AutomationRuleVersion[]
  workflowSteps WorkflowStep[]
  selections CandidateSelectionDecision[]
  qualityReports ContentQualityReport[]
  usageEvents UsageEvent[]
  budgetPolicy BudgetPolicy?
  budgetReservations BudgetReservation[]
  analyticsSyncRuns AnalyticsSyncRun[]
  recommendations PerformanceRecommendation[]
  experiments Experiment[]
  experimentAssignments ExperimentAssignment[]
}

model WorkspaceMember {
  workspaceId String
  userId      String
  role        Role                @default(VIEWER)
  createdAt   DateTime            @default(now())
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions    Session[]
  reviews     ContentRight[]
  audits      AuditLog[]
  idempotency IdempotencyRecord[]
  productionRuns ProductionRun[]

  @@id([workspaceId, userId])
  @@index([userId])
}

model ContentChannel {
  id               String         @id @default(uuid())
  workspaceId      String
  name             String
  language         String         @default("vi")
  topicConfig      Json
  automationConfig Json
  minimumCandidateScore Float        @default(55)
  createdAt        DateTime       @default(now())
  workspace        Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sources          SourceConfig[]
  topicRules       TopicRule[]
  posts            SourcePost[]
  videos           Video[]
  stories          StoryProject[]
  automationRule   AutomationRule?
  selections       CandidateSelectionDecision[]
  usageEvents      UsageEvent[]
  experiments      Experiment[]

  @@unique([workspaceId, id])
  @@index([workspaceId, createdAt])
}

model SourceConfig {
  id               String          @id @default(uuid())
  workspaceId      String
  channelId        String?
  platform         Platform
  sourceKey        String
  config           Json
  enabled          Boolean         @default(false)
  capabilityStatus String          @default("BLOCKED_EXTERNAL")
  syncFrequencyMinutes Int         @default(1440)
  lastSyncStatus   String          @default("NEVER")
  lastErrorCode    String?
  lastErrorAt      DateTime?
  nextSyncAt       DateTime?
  lastSyncAt       DateTime?
  updatedAt        DateTime        @default(now()) @updatedAt
  createdAt        DateTime        @default(now())
  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel          ContentChannel? @relation(fields: [workspaceId, channelId], references: [workspaceId, id], onDelete: Restrict)
  runs             SourceSyncRun[]
  posts            SourcePost[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, platform, sourceKey])
  @@index([enabled, nextSyncAt])
}

model SourceSyncRun {
  id             String       @id @default(uuid())
  workspaceId    String
  sourceConfigId String
  status         String
  idempotencyKey String?
  cursor         String?
  nextCursor     String?
  fetchedCount   Int          @default(0)
  duplicateCount Int          @default(0)
  attempts       Int          @default(0)
  errorCode      String?
  startedAt      DateTime     @default(now())
  finishedAt     DateTime?
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source         SourceConfig @relation(fields: [workspaceId, sourceConfigId], references: [workspaceId, id], onDelete: Cascade)
  metricSnapshots PostMetricSnapshot[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, sourceConfigId, idempotencyKey])
  @@index([workspaceId, sourceConfigId, startedAt])
}

model SourcePost {
  id              String               @id @default(uuid())
  workspaceId     String
  sourceConfigId  String?
  channelId       String?
  platform        Platform
  externalPostId  String
  canonicalUrl    String
  title           String?
  body            String               @db.Text
  authorAlias     String?
  language        String?
  topicTags       String[]             @default([])
  contentHash     String
  rawPayload      Json?
  synthetic       Boolean              @default(false)
  sensitiveFlags  String[]             @default([])
  publishedAt     DateTime?
  discoveredAt    DateTime             @default(now())
  deletedAt       DateTime?
  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source          SourceConfig?        @relation(fields: [workspaceId, sourceConfigId], references: [workspaceId, id], onDelete: Restrict)
  channel         ContentChannel?      @relation(fields: [workspaceId, channelId], references: [workspaceId, id], onDelete: Restrict)
  comments        SourceComment[]
  rights          ContentRight[]
  candidates      ContentCandidate[]
  metricSnapshots PostMetricSnapshot[]
  stories         StoryProject[]
  selections      CandidateSelectionDecision[]
  experimentAssignments ExperimentAssignment[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, platform, externalPostId])
  @@unique([workspaceId, platform, contentHash])
  @@index([workspaceId, discoveredAt])
}

model SourceComment {
  id               String     @id @default(uuid())
  workspaceId      String
  sourcePostId     String
  externalId       String
  parentExternalId String?
  body             String     @db.Text
  sensitiveFlags   String[]   @default([])
  likes            Int?
  publishedAt      DateTime?
  workspace        Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  post             SourcePost @relation(fields: [workspaceId, sourcePostId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@unique([sourcePostId, externalId])
  @@index([workspaceId, sourcePostId])
}

model PostMetricSnapshot {
  id           String     @id @default(uuid())
  workspaceId  String
  sourcePostId String
  sourceSyncRunId String?
  measuredAt   DateTime   @default(now())
  likes        Int?
  replies      Int?
  shares       Int?
  views        Int?
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  post         SourcePost @relation(fields: [workspaceId, sourcePostId], references: [workspaceId, id], onDelete: Cascade)
  syncRun      SourceSyncRun? @relation(fields: [workspaceId, sourceSyncRunId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@index([workspaceId, sourcePostId, measuredAt])
}

model ContentCandidate {
  id           String     @id @default(uuid())
  workspaceId  String
  sourcePostId String
  score        Float?
  factors      Json?
  modelVersion String?
  reasoning    String?    @db.Text
  eligibility  Json?
  minimumScore Float      @default(55)
  scoredAt     DateTime?
  status       String     @default("PENDING")
  createdAt    DateTime   @default(now())
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  post         SourcePost @relation(fields: [workspaceId, sourcePostId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@unique([workspaceId, sourcePostId])
  @@index([workspaceId, status, score])
}

model TopicRule {
  id           String         @id @default(uuid())
  workspaceId  String
  channelId    String
  name         String
  keywords     String[]       @default([])
  hashtags     String[]       @default([])
  topics       String[]       @default([])
  language     String?
  allow        String[]       @default([])
  deny         String[]       @default([])
  minimumScore Float          @default(55)
  enabled      Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel      ContentChannel  @relation(fields: [workspaceId, channelId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@unique([workspaceId, channelId, name])
  @@index([workspaceId, enabled])
}

model ContentRight {
  id                  String           @id @default(uuid())
  workspaceId         String
  sourcePostId        String
  basis               RightsBasis      @default(UNKNOWN)
  evidenceAssetId     String?
  evidence            String?          @db.Text
  attested            Boolean          @default(false)
  allowedPlatforms    Platform[]       @default([])
  commercialAllowed   Boolean          @default(false)
  territory           String           @default("UNSPECIFIED")
  attributionRequired Boolean          @default(false)
  attributionText     String?
  expiresAt           DateTime?
  reviewStatus        ReviewStatus     @default(PENDING)
  reviewedById        String?
  reviewedAt          DateTime?
  revokedAt           DateTime?
  createdAt           DateTime         @default(now())
  workspace           Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  post                SourcePost       @relation(fields: [workspaceId, sourcePostId], references: [workspaceId, id], onDelete: Cascade)
  evidenceAsset       MediaAsset?      @relation(fields: [workspaceId, evidenceAssetId], references: [workspaceId, id], onDelete: Restrict)
  reviewer            WorkspaceMember? @relation(fields: [workspaceId, reviewedById], references: [workspaceId, userId], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@index([workspaceId, reviewStatus])
  @@index([workspaceId, sourcePostId])
}

model StoryProject {
  id           String         @id @default(uuid())
  workspaceId  String
  sourcePostId String
  channelId    String?
  status       String         @default("DRAFT")
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  post         SourcePost     @relation(fields: [workspaceId, sourcePostId], references: [workspaceId, id], onDelete: Cascade)
  channel      ContentChannel? @relation(fields: [workspaceId, channelId], references: [workspaceId, id], onDelete: Restrict)
  versions     StoryVersion[]
  videos       Video[]
  productionRuns ProductionRun[]

  @@unique([workspaceId, id])
  @@index([workspaceId, sourcePostId])
}

model StoryVersion {
  id             String       @id @default(uuid())
  workspaceId    String
  storyProjectId String
  version        Int
  script         Json
  modelVersion   String?
  createdAt      DateTime     @default(now())
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  story          StoryProject @relation(fields: [workspaceId, storyProjectId], references: [workspaceId, id], onDelete: Cascade)
  audioAssets    AudioAsset[]
  subtitleTracks SubtitleTrack[]
  videos         Video[]

  @@unique([workspaceId, id])
  @@unique([storyProjectId, version])
}

model MediaAsset {
  id             String         @id @default(uuid())
  workspaceId    String
  kind           String
  storageKey     String
  checksum       String
  mimeType       String
  metadata       Json?
  rightsMetadata Json?
  createdAt      DateTime       @default(now())
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  evidenceFor    ContentRight[]
  videos         Video[]
  audioAssets    AudioAsset[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, storageKey])
}

model Video {
  id             String         @id @default(uuid())
  workspaceId    String
  channelId      String
  storyProjectId String?
  storyVersionId String?
  productionRunId String?
  title          String
  status         String         @default("DRAFT")
  renderManifest Json?
  mediaAssetId   String?
  durationMs     Int?
  width          Int?
  height         Int?
  fps            Int?
  reviewStatus   ReviewStatus   @default(PENDING)
  createdAt      DateTime       @default(now())
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel        ContentChannel @relation(fields: [workspaceId, channelId], references: [workspaceId, id], onDelete: Restrict)
  story          StoryProject?  @relation(fields: [workspaceId, storyProjectId], references: [workspaceId, id], onDelete: Restrict)
  storyVersion   StoryVersion?  @relation(fields: [workspaceId, storyVersionId], references: [workspaceId, id], onDelete: Restrict)
  productionRun  ProductionRun? @relation(fields: [workspaceId, productionRunId], references: [workspaceId, id], onDelete: Restrict)
  mediaAsset     MediaAsset?    @relation(fields: [workspaceId, mediaAssetId], references: [workspaceId, id], onDelete: Restrict)
  publications   Publication[]
  renderJob      RenderJob?
  qualityReports ContentQualityReport[]
  experimentAssignments ExperimentAssignment[]

  @@unique([workspaceId, id])
  @@index([workspaceId, status])
  @@unique([workspaceId, productionRunId])
}

model ProductionRun {
  id             String              @id @default(uuid())
  workspaceId    String
  storyProjectId String
  requestedById  String
  idempotencyKey String
  status         ProductionRunStatus @default(QUEUED)
  currentStage   String?
  input          Json
  attempts       Int                 @default(0)
  workerLeaseUntil DateTime?
  errorCode      String?
  createdAt      DateTime            @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  updatedAt      DateTime            @updatedAt
  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  story          StoryProject        @relation(fields: [workspaceId, storyProjectId], references: [workspaceId, id], onDelete: Cascade)
  requestedBy    WorkspaceMember     @relation(fields: [workspaceId, requestedById], references: [workspaceId, userId], onDelete: Restrict)
  stages         ProductionStage[]
  manifests      RenderManifest[]
  renderJob      RenderJob?
  videos         Video[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, status, createdAt])
}

model ProductionStage {
  id              String               @id @default(uuid())
  workspaceId     String
  productionRunId String
  name            String
  status          ProductionStageStatus @default(PENDING)
  attempts        Int                  @default(0)
  errorCode       String?
  output           Json?
  startedAt       DateTime?
  completedAt     DateTime?
  updatedAt       DateTime             @updatedAt
  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  productionRun   ProductionRun        @relation(fields: [workspaceId, productionRunId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@unique([workspaceId, productionRunId, name])
  @@index([workspaceId, status, updatedAt])
}

model AudioAsset {
  id                String       @id @default(uuid())
  workspaceId       String
  storyVersionId    String
  mediaAssetId      String
  segmentId         String
  voiceProfileId    String
  provider          String
  cacheKey          String
  durationMs        Int
  timingPrecision   String       @default("APPROXIMATE")
  usageUnits        Int?
  estimatedCostUsd  Float?
  createdAt         DateTime     @default(now())
  workspace         Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  storyVersion      StoryVersion @relation(fields: [workspaceId, storyVersionId], references: [workspaceId, id], onDelete: Cascade)
  mediaAsset        MediaAsset   @relation(fields: [workspaceId, mediaAssetId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@unique([workspaceId, cacheKey])
  @@index([workspaceId, storyVersionId, segmentId])
}

model SubtitleTrack {
  id             String       @id @default(uuid())
  workspaceId    String
  storyVersionId String
  language       String
  preset         String
  timingPrecision String       @default("APPROXIMATE")
  timeline       Json
  srt            String       @db.Text
  createdAt      DateTime     @default(now())
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  storyVersion   StoryVersion @relation(fields: [workspaceId, storyVersionId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@unique([workspaceId, storyVersionId, preset])
}

model RenderManifest {
  id              String        @id @default(uuid())
  workspaceId     String
  productionRunId String
  version         Int           @default(1)
  checksum        String
  manifest        Json
  createdAt       DateTime      @default(now())
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  productionRun   ProductionRun @relation(fields: [workspaceId, productionRunId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@unique([workspaceId, productionRunId, version])
  @@index([workspaceId, checksum])
}

model RenderJob {
  id              String        @id @default(uuid())
  workspaceId     String
  productionRunId String
  videoId         String?
  status          String        @default("QUEUED")
  progress        Float         @default(0)
  attempts        Int           @default(0)
  errorCode       String?
  startedAt       DateTime?
  completedAt     DateTime?
  updatedAt       DateTime      @updatedAt
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  productionRun   ProductionRun @relation(fields: [workspaceId, productionRunId], references: [workspaceId, id], onDelete: Cascade)
  video           Video?        @relation(fields: [workspaceId, videoId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@unique([workspaceId, productionRunId])
  @@unique([workspaceId, videoId])
  @@index([workspaceId, status, updatedAt])
}

model SocialAccount {
  id              String        @id @default(uuid())
  workspaceId     String
  platform        Platform
  externalId      String
  displayName     String
  secretRef       String?
  status          String        @default("DISCONNECTED")
  capabilityFlags Json?
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  publications    Publication[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, platform, externalId])
}

model Publication {
  id              String               @id @default(uuid())
  workspaceId     String
  videoId         String
  socialAccountId String
  status          PublicationStatus    @default(DRAFT)
  scheduledAt     DateTime?
  publishedAt     DateTime?
  remotePostId    String?
  remoteUrl       String?
  idempotencyKey  String               @unique
  metadata        Json?
  errorCode       String?
  createdAt       DateTime             @default(now())
  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  video           Video                @relation(fields: [workspaceId, videoId], references: [workspaceId, id], onDelete: Cascade)
  account         SocialAccount        @relation(fields: [workspaceId, socialAccountId], references: [workspaceId, id], onDelete: Restrict)
  attempts        PublicationAttempt[]
  metrics         PublicationMetric[]
  analyticsSyncRuns AnalyticsSyncRun[]

  @@unique([workspaceId, id])
  @@index([status, scheduledAt])
  @@index([workspaceId, videoId])
}

model PublicationAttempt {
  id               String      @id @default(uuid())
  workspaceId      String
  publicationId    String
  attemptNo        Int
  stage            String
  operationId      String?
  uploadSessionRef String?
  errorCode        String?
  startedAt        DateTime    @default(now())
  completedAt      DateTime?
  workspace        Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  publication      Publication @relation(fields: [workspaceId, publicationId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@unique([publicationId, attemptNo])
}

model PublicationMetric {
  id            String      @id @default(uuid())
  workspaceId   String
  publicationId String
  measuredAt    DateTime    @default(now())
  metrics       Json
  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  publication   Publication @relation(fields: [workspaceId, publicationId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@index([workspaceId, publicationId, measuredAt])
}

model WorkflowRun {
  id          String    @id @default(uuid())
  workspaceId String
  entityType  String
  entityId    String
  status      String
  currentStep String?
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  input       Json?
  output      Json?
  errorCode   String?
  attempts    Int       @default(0)
  leaseUntil  DateTime?
  nextRunAt   DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  steps       WorkflowStep[]
  selections CandidateSelectionDecision[]
  qualityReports ContentQualityReport[]
  usageEvents UsageEvent[]
  reservation BudgetReservation?

  @@unique([workspaceId, id])
  @@index([workspaceId, entityType, entityId])
  @@index([entityType, status, nextRunAt])
}

model AutomationRule {
  id String @id @default(uuid())
  workspaceId String
  channelId String
  version Int @default(1)
  status String @default("DISABLED")
  controlVersion Int @default(1)
  config Json
  nextRunAt DateTime?
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  channel ContentChannel @relation(fields:[workspaceId,channelId], references:[workspaceId,id], onDelete:Cascade)
  versions AutomationRuleVersion[]
  @@unique([workspaceId,id])
  @@unique([workspaceId,channelId])
  @@index([status,nextRunAt])
}

model AutomationRuleVersion {
  id String @id @default(uuid())
  workspaceId String
  ruleId String
  version Int
  config Json
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  rule AutomationRule @relation(fields:[workspaceId,ruleId], references:[workspaceId,id], onDelete:Cascade)
  @@unique([workspaceId,id])
  @@unique([ruleId,version])
}

model WorkflowStep {
  id String @id @default(uuid())
  workspaceId String
  workflowRunId String
  name String
  status String @default("PENDING")
  startedAt DateTime?
  completedAt DateTime?
  errorCode String?
  output Json?
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  workflow WorkflowRun @relation(fields:[workspaceId,workflowRunId], references:[workspaceId,id], onDelete:Cascade)
  @@unique([workspaceId,id])
  @@unique([workflowRunId,name])
}

model CandidateSelectionDecision {
  id String @id @default(uuid())
  workspaceId String
  channelId String
  sourcePostId String
  workflowRunId String
  candidateId String
  algorithmVersion String
  reasoning Json
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  channel ContentChannel @relation(fields:[workspaceId,channelId], references:[workspaceId,id], onDelete:Cascade)
  post SourcePost @relation(fields:[workspaceId,sourcePostId], references:[workspaceId,id], onDelete:Cascade)
  workflow WorkflowRun @relation(fields:[workspaceId,workflowRunId], references:[workspaceId,id], onDelete:Cascade)
  @@unique([workspaceId,id])
  @@unique([workspaceId,channelId,sourcePostId])
}

model ContentQualityReport {
  id String @id @default(uuid())
  workspaceId String
  workflowRunId String
  videoId String
  status String
  score Float
  report Json
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  workflow WorkflowRun @relation(fields:[workspaceId,workflowRunId], references:[workspaceId,id], onDelete:Cascade)
  video Video @relation(fields:[workspaceId,videoId], references:[workspaceId,id], onDelete:Cascade)
  @@unique([workspaceId,id])
  @@unique([workflowRunId,videoId])
}

model BudgetPolicy {
  id String @id @default(uuid())
  workspaceId String @unique
  dailyLimitUsd Decimal @db.Decimal(12,6)
  monthlyLimitUsd Decimal @db.Decimal(12,6)
  warningThreshold Float @default(0.8)
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  @@unique([workspaceId,id])
}

model BudgetReservation {
  id String @id @default(uuid())
  workspaceId String
  workflowRunId String
  amountUsd Decimal @db.Decimal(12,6)
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  workflow WorkflowRun @relation(fields:[workspaceId,workflowRunId], references:[workspaceId,id], onDelete:Cascade)
  @@unique([workspaceId,id])
  @@unique([workflowRunId])
  @@unique([workspaceId,workflowRunId])
  @@index([workspaceId,status])
}

model UsageEvent {
  id String @id @default(uuid())
  workspaceId String
  channelId String?
  workflowRunId String?
  key String
  stage String
  units Float
  unit String
  estimatedUsd Decimal? @db.Decimal(12,6)
  billedUsd Decimal? @db.Decimal(12,6)
  occurredAt DateTime @default(now())
  metadata Json?
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  channel ContentChannel? @relation(fields:[workspaceId,channelId], references:[workspaceId,id], onDelete:Restrict)
  workflow WorkflowRun? @relation(fields:[workspaceId,workflowRunId], references:[workspaceId,id], onDelete:Restrict)
  @@unique([workspaceId,id])
  @@unique([workspaceId,key])
  @@index([workspaceId,occurredAt])
}

model AnalyticsSyncRun {
  id String @id @default(uuid())
  workspaceId String
  publicationId String
  status String @default("QUEUED")
  attempts Int @default(0)
  errorCode String?
  leaseUntil DateTime?
  nextRunAt DateTime?
  createdAt DateTime @default(now())
  completedAt DateTime?
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  publication Publication @relation(fields:[workspaceId,publicationId], references:[workspaceId,id], onDelete:Cascade)
  @@unique([workspaceId,id])
  @@index([status,nextRunAt])
}

model PerformanceRecommendation {
  id String @id @default(uuid())
  workspaceId String
  key String
  algorithmVersion String
  status String @default("PENDING")
  kind String
  title String
  explanation String
  evidence Json
  createdAt DateTime @default(now())
  decidedAt DateTime?
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  @@unique([workspaceId,id])
  @@unique([workspaceId,key])
}

model Experiment {
  id String @id @default(uuid())
  workspaceId String
  channelId String
  name String
  hypothesis String
  dimension String
  variants Json
  minSamples Int @default(10)
  status String @default("PENDING_APPROVAL")
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  channel ContentChannel @relation(fields:[workspaceId,channelId], references:[workspaceId,id], onDelete:Cascade)
  assignments ExperimentAssignment[]
  @@unique([workspaceId,id])
}

model ExperimentAssignment {
  id String @id @default(uuid())
  workspaceId String
  experimentId String
  sourcePostId String
  videoId String
  variantId String
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  experiment Experiment @relation(fields:[workspaceId,experimentId], references:[workspaceId,id], onDelete:Cascade)
  post SourcePost @relation(fields:[workspaceId,sourcePostId], references:[workspaceId,id], onDelete:Cascade)
  video Video @relation(fields:[workspaceId,videoId], references:[workspaceId,id], onDelete:Cascade)
  @@unique([workspaceId,id])
  @@unique([experimentId,sourcePostId])
  @@unique([experimentId,videoId])
}

model OutboxEvent {
  id          String    @id @default(uuid())
  workspaceId String
  eventType   String
  aggregateId String
  payload     Json
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@index([publishedAt, createdAt])
}

model AuditLog {
  id           String           @id @default(uuid())
  workspaceId  String
  actorId      String?
  action       String
  resourceType String
  resourceId   String
  metadata     Json?
  occurredAt   DateTime         @default(now())
  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor        WorkspaceMember? @relation(fields: [workspaceId, actorId], references: [workspaceId, userId], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@index([workspaceId, occurredAt])
}

model IdempotencyRecord {
  id          String          @id @default(uuid())
  workspaceId String
  userId      String
  route       String
  key         String
  requestHash String
  response    Json
  statusCode  Int
  createdAt   DateTime        @default(now())
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member      WorkspaceMember @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@unique([workspaceId, userId, route, key])
  @@index([createdAt])
}
